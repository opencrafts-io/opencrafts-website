# PostHog. Analytics stays off unless a key is set, so local development is
# silent by default — copy this file to .env.local and fill it in only if you
# need to test tracking.
#
# NEXT_PUBLIC_ variables are inlined at build time. For production, set these
# as repository variables so the deploy workflow can pass them through.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
